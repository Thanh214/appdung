<mxfile host="app.diagrams.net" modified="2024-01-01T00:00:00.000Z" agent="draw.io" version="22.0.0">
  <diagram name="Điều khiển đơn giản" id="dieu-khien-don-gian">
    <mxGraphModel dx="800" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="LƯU ĐỒ THUẬT TOÁN ĐIỀU KHIỂN TỰ ĐỘNG" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#1a5f2a" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="380" height="30" as="geometry" />
        </mxCell>
        
        <!-- Start -->
        <mxCell id="start" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="360" y="70" width="100" height="50" as="geometry" />
        </mxCell>
        
        <!-- Input: Read sensors -->
        <mxCell id="input1" value="Đọc cảm biến&#xa;(Nhiệt độ, Độ ẩm đất)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="160" height="50" as="geometry" />
        </mxCell>
        
        <!-- Input: Read thresholds -->
        <mxCell id="input2" value="Đọc ngưỡng cài đặt" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="340" y="230" width="140" height="45" as="geometry" />
        </mxCell>
        
        <!-- Decision: Temperature > Threshold -->
        <mxCell id="dec1" value="Nhiệt độ&#xa;&gt; Ngưỡng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="350" y="305" width="120" height="80" as="geometry" />
        </mxCell>
        
        <!-- Process: Turn ON Fan -->
        <mxCell id="on-fan" value="BẬT Quạt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="325" width="100" height="40" as="geometry" />
        </mxCell>
        
        <!-- Process: Turn OFF Fan -->
        <mxCell id="off-fan" value="TẮT Quạt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="325" width="100" height="40" as="geometry" />
        </mxCell>
        
        <!-- Decision: Soil < Threshold -->
        <mxCell id="dec2" value="Độ ẩm đất&#xa;&lt; Ngưỡng?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="350" y="415" width="120" height="80" as="geometry" />
        </mxCell>
        
        <!-- Process: Turn ON Pump -->
        <mxCell id="on-pump" value="BẬT Bơm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="435" width="100" height="40" as="geometry" />
        </mxCell>
        
        <!-- Process: Turn OFF Pump -->
        <mxCell id="off-pump" value="TẮT Bơm" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="200" y="435" width="100" height="40" as="geometry" />
        </mxCell>
        
        <!-- Output: Update relays -->
        <mxCell id="output1" value="Cập nhật trạng thái Relay" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="335" y="535" width="150" height="45" as="geometry" />
        </mxCell>
        
        <!-- Process: Wait -->
        <mxCell id="wait" value="Chờ 3 giây" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="360" y="610" width="100" height="40" as="geometry" />
        </mxCell>
        
        <!-- Arrows -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="start" target="input1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="input1" target="input2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="input2" target="dec1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="a4" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=11" edge="1" parent="1" source="dec1" target="on-fan">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a5" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=11" edge="1" parent="1" source="dec1" target="off-fan">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="on-fan" target="dec2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="570" y="455" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="off-fan" target="dec2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="250" y="455" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a8" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=11" edge="1" parent="1" source="dec2" target="on-pump">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a9" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=11" edge="1" parent="1" source="dec2" target="off-pump">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="on-pump" target="output1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="570" y="557" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="off-pump" target="output1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="250" y="557" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="output1" target="wait">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Decision: Stop control? -->
        <mxCell id="dec-stop" value="Dừng điều&#xa;khiển?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="365" y="675" width="90" height="65" as="geometry" />
        </mxCell>

        <!-- End (Oval) -->
        <mxCell id="end" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="360" y="765" width="100" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow: wait to decision -->
        <mxCell id="a13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="wait" target="dec-stop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: Yes -> End -->
        <mxCell id="a14" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=11" edge="1" parent="1" source="dec-stop" target="end">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Loop back -->
        <mxCell id="loop" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1;fontSize=11" edge="1" parent="1" source="dec-stop" target="input1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="707" />
              <mxPoint x="680" y="175" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Note -->
        <mxCell id="note" value="Ghi chú:&#xa;• Kiểm tra nhiệt độ → Điều khiển Quạt&#xa;• Kiểm tra độ ẩm đất → Điều khiển Bơm&#xa;• Vòng lặp liên tục mỗi 3 giây" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;fontSize=11;fontStyle=0;rounded=1;spacing=5" vertex="1" parent="1">
          <mxGeometry x="120" y="850" width="580" height="60" as="geometry" />
        </mxCell>
        
        <!-- Footer -->
        <mxCell id="footer" value="Hình: Lưu đồ thuật toán điều khiển tự động (1 nhánh duy nhất)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="220" y="760" width="380" height="20" as="geometry" />
        </mxCell>
        
      </root>
