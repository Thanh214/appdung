        <!-- Note -->
        <mxCell id="note" value="Ghi chú:&#xa;• Hysteresis: Tránh gửi liên tục khi gần ngưỡng&#xa;• Cooldown: 5 phút để tránh spam notification&#xa;• MQTT alarm: Gửi đến server lưu log&#xa;• Push notification: Hiển thị trên App ngay lập tức" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;fontSize=10;fontStyle=0;rounded=1;spacing=5" vertex="1" parent="1">
