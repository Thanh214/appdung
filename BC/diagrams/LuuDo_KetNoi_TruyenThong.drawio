<mxfile host="app.diagrams.net" modified="2024-01-01T00:00:00.000Z" agent="draw.io" version="22.0.0">
  <diagram name="Kết nối và truyền thông" id="ket-noi-truyen-thong">
    <mxGraphModel dx="1000" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="LƯU ĐỒ THUẬT TOÁN KẾT NỐI VÀ TRUYỀN THÔNG" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#1a5f2a" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="460" height="30" as="geometry" />
        </mxCell>
        
        <!-- Start -->
        <mxCell id="start" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="360" y="70" width="100" height="50" as="geometry" />
        </mxCell>
        
        <!-- Process: Init WiFi -->
        <mxCell id="init-wifi" value="Khởi tạo WiFi Module" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="345" y="145" width="130" height="40" as="geometry" />
        </mxCell>
        
        <!-- Decision: WiFi connected? -->
        <mxCell id="dec-wifi" value="Kết nối&#xa;WiFi thành công?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="350" y="210" width="120" height="75" as="geometry" />
        </mxCell>
        
        <!-- Process: Start AP mode -->
        <mxCell id="ap-mode" value="Khởi động chế độ AP&#xa;(Cấu hình WiFi)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="530" y="222.5" width="130" height="50" as="geometry" />
        </mxCell>
        
        <!-- Process: Connect MQTT -->
        <mxCell id="mqtt-connect" value="Kết nối MQTT Broker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="345" y="315" width="130" height="40" as="geometry" />
        </mxCell>
        
        <!-- Decision: MQTT connected? -->
        <mxCell id="dec-mqtt" value="MQTT&#xa;kết nối OK?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="360" y="380" width="100" height="70" as="geometry" />
        </mxCell>
        
        <!-- Process: Retry MQTT -->
        <mxCell id="mqtt-retry" value="Chờ và thử lại" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="530" y="395" width="100" height="40" as="geometry" />
        </mxCell>
        
        <!-- Input/Output: Subscribe topics -->
        <mxCell id="subscribe" value="Subscribe các topics&#xa;(config, cmd, ota)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="330" y="480" width="160" height="50" as="geometry" />
        </mxCell>
        
        <!-- Output: Publish status -->
        <mxCell id="pub-status" value="Publish trạng thái Online" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="335" y="560" width="150" height="45" as="geometry" />
        </mxCell>
        
        <!-- Process: Main loop -->
        <mxCell id="loop-start" value="Vòng lặp chính" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="350" y="635" width="120" height="40" as="geometry" />
        </mxCell>
        
        <!-- Output: Publish telemetry -->
        <mxCell id="pub-tele" value="Gửi dữ liệu cảm biến&#xa;(MQTT + HTTP)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="335" y="705" width="150" height="50" as="geometry" />
        </mxCell>
        
        <!-- Input: Receive command -->
        <mxCell id="recv-cmd" value="Nhận lệnh từ MQTT&#xa;(config, relay, OTA)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="335" y="785" width="150" height="50" as="geometry" />
        </mxCell>
        
        <!-- Decision: Is OTA command? -->
        <mxCell id="dec-ota" value="Lệnh&#xa;OTA?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="370" y="865" width="80" height="65" as="geometry" />
        </mxCell>
        
        <!-- Process: Execute OTA -->
        <mxCell id="ota-update" value="Tải firmware từ HTTP&#xa;Cập nhật OTA&#xa;Khởi động lại" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="530" y="867.5" width="130" height="60" as="geometry" />
        </mxCell>
        
        <!-- Process: Execute command -->
        <mxCell id="exec-cmd" value="Xử lý lệnh điều khiển&#xa;(Cập nhật ngưỡng, Relay)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="340" y="960" width="140" height="50" as="geometry" />
        </mxCell>
        
        <!-- Output: Send ACK -->
        <mxCell id="send-ack" value="Gửi ACK xác nhận" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="350" y="1040" width="120" height="40" as="geometry" />
        </mxCell>
        
        <!-- Process: Wait -->
        <mxCell id="wait" value="Chờ 3 giây" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="365" y="1105" width="90" height="35" as="geometry" />
        </mxCell>
        
        <!-- Arrows -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="start" target="init-wifi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="init-wifi" target="dec-wifi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="a3" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=10" edge="1" parent="1" source="dec-wifi" target="ap-mode">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1" edge="1" parent="1" source="ap-mode" target="dec-wifi">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="595" y="200" />
              <mxPoint x="520" y="200" />
              <mxPoint x="520" y="247" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a5" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=10" edge="1" parent="1" source="dec-wifi" target="mqtt-connect">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="mqtt-connect" target="dec-mqtt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="a7" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=10" edge="1" parent="1" source="dec-mqtt" target="mqtt-retry">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1" edge="1" parent="1" source="mqtt-retry" target="mqtt-connect">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="360" />
              <mxPoint x="520" y="360" />
              <mxPoint x="520" y="335" />
            </Array>
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a9" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=10" edge="1" parent="1" source="dec-mqtt" target="subscribe">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="subscribe" target="pub-status">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="a11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="pub-status" target="loop-start">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="a12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="loop-start" target="pub-tele">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="a13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="pub-tele" target="recv-cmd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="a14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="recv-cmd" target="dec-ota">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="a15" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=10" edge="1" parent="1" source="dec-ota" target="ota-update">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a16" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=10" edge="1" parent="1" source="dec-ota" target="exec-cmd">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        
        <mxCell id="a17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="exec-cmd" target="send-ack">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <mxCell id="a18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="send-ack" target="wait">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Decision: Disconnect? -->
        <mxCell id="dec-stop" value="Ngắt kết nối?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="370" y="1160" width="80" height="60" as="geometry" />
        </mxCell>

        <!-- End (Oval) -->
        <mxCell id="end" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="360" y="1245" width="100" height="50" as="geometry" />
        </mxCell>

        <!-- Arrow: wait to decision -->
        <mxCell id="a19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2" edge="1" parent="1" source="wait" target="dec-stop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: Yes -> End -->
        <mxCell id="a20" value="Có" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fontSize=11" edge="1" parent="1" source="dec-stop" target="end">
          <mxGeometry x="-0.2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Loop back -->
        <mxCell id="loop" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;dashed=1;fontSize=11" edge="1" parent="1" source="dec-stop" target="loop-start">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="130" y="1190" />
              <mxPoint x="130" y="655" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Note: OTA restart -->
        <mxCell id="note-ota" value="Sau OTA:&#xa;Khởi động lại → Quay về đầu" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;rounded=1" vertex="1" parent="1">
          <mxGeometry x="680" y="877.5" width="130" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="arrow-ota-note" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;dashed=1;strokeColor=#d79b00" edge="1" parent="1" source="ota-update" target="note-ota">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- Legend -->
        <mxCell id="legend" value="Ghi chú:&#xa;• WiFi: Kết nối mạng không dây&#xa;• MQTT: Giao thức truyền thông với App&#xa;• HTTP: Tải firmware OTA từ server&#xa;• Telemetry: Dữ liệu cảm biến (3s/lần)" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;fontSize=10;fontStyle=0;rounded=1;spacing=5" vertex="1" parent="1">
          <mxGeometry x="560" y="640" width="220" height="90" as="geometry" />
        </mxCell>
        
        <!-- Footer -->
        <mxCell id="footer" value="Hình: Lưu đồ thuật toán kết nối và truyền thông ESP32" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="220" y="1160" width="380" height="20" as="geometry" />
        </mxCell>
        
      </root>
