          <mxGeometry x="355" y="395" width="110" height="75" as="geometry" />
        </mxCell>
        
        <!-- Process: Set soil alarm flag -->
        <mxCell id="flag-soil" value="Đánh dấu cảnh báo&#xa;độ ẩm đất" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="530" y="407.5" width="120" height="50" as="geometry" />
        </mxCell>
        
        <!-- Decision: Any alarm? -->
